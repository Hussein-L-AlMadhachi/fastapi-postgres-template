# Copy to .env, which is gitignored:  cp .env.example .env

# --- backend (local runs) --------------------------------------------------
# DSN used by db.py. Wins over the PG* variables further down.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app

# Optional. The unit tests use a fake asyncpg connection, so they need no
# database. Set this only if you add integration tests later.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app

# --- docker compose --------------------------------------------------------
# Credentials for the db service. The backend container gets its own
# DATABASE_URL from compose.yml, built from these values with host "db", so
# only keep the password in sync with DATABASE_URL above when you change it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# --- alternative to DATABASE_URL -------------------------------------------
# Remove DATABASE_URL to build the DSN from the libpq variables instead. psql
# reads the same names, so a plain `psql` then connects to the same database.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=app

# --- auth ------------------------------------------------------------------
# Required. Generate one with: openssl rand -hex 32
APP_SECRET=EXAMPLE_TOP_SECRET_KEY_FOR_AUTH

# Comma separated list of enabled flows: password, email_otp, phone_otp.
# Remove a flow to hide its endpoints (disabled flows answer 404).
AUTH_METHODS=password,email_otp,phone_otp

# Create a user on the first OTP request when the identifier is unknown.
AUTH_OTP_AUTO_SIGNUP=true

# OTP validity and JWT lifetime.
OTP_TTL_MINUTES=5
ACCESS_TOKEN_TTL_HOURS=24

# "dev" logs OTP codes so you can complete the flow locally. Never use dev in production.
APP_ENV=dev
